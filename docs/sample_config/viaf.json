{
	"name": "viaf",
	"type": "external",
	"namespace": "http://viaf.org/viaf/",
	"matches": ["viaf.org/viaf/"],
	"fetch": "https://viaf.org/viaf/{identifier}/viaf.xml",
    "wikidata_property": ["P214"],
    "merge_order": 70,
    
	"fetcherClass": "sources.oclc.fetcher.ViafFetcher",
	"mapperClass": "sources.oclc.mapper.ViafMapper",
	"loaderClass": "sources.oclc.loader.ViafLoader",
	"indexLoaderClass": "sources.oclc.index_loader.ViafIndexLoader",
	"reconcilerClass": "sources.oclc.reconciler.ViafReconciler",

    "inverseEquivDbPath": "id_to_viaf.sqlite",        
	"reconcileDumpPath": "viaf/viaf-links.txt.gz",
    "dumpFilePath": "viaf/viaf-clusters.xml.gz",

    "downloaderClass": "sources.oclc.downloader.ViafDownloader",
    "downloadMdUrl": "https://viaf.org/api/download/files",
    "downloadXPath": "queryResult/Monthly/clusterRdfXml",
    "downloadUrlBase": "https://downloads.viaf.org/viaf/data/monthly/",
    "dumps_dir": "viaf"
}
